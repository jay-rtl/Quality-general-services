---
import Logo from '@/components/ui/Logo.astro';
import { services, serviceHref } from '@/data/services';
import { ctas } from '@/data/navigation';
import { site } from '@/config/site';

const year = new Date().getFullYear();
const company = [
  { label: 'About Us', href: '/about' },
  { label: 'Our Services', href: '/services' },
  { label: 'Projects', href: '/projects' },
  { label: 'Careers', href: '/careers' },
  { label: 'Contact', href: '/contact' },
];
const a = site.contact.address;
---

<footer class="bg-ink text-white" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Site footer</h2>
  <div class="container-x pb-10 pt-24 md:pt-32">
    <div class="grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <Logo width={236} eager={false} class="w-[210px] md:w-[236px]" />
        <p class="mt-10 max-w-sm text-[0.9375rem] leading-relaxed text-white/60">
          Restoration support, commercial cleaning, specialized remediation and workforce solutions across {site.serviceArea}.
        </p>
        <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-[0.9375rem]">
          <a href={ctas.quote.href} class="link-line text-white">{ctas.quote.label}</a>
          <a href={ctas.apply.href} class="link-line text-white">{ctas.apply.label}</a>
        </div>
      </div>

      <nav class="lg:col-span-4 lg:col-start-6" aria-label="Services">
        <p class="eyebrow text-white/45">Services</p>
        <ul class="mt-7 grid gap-3 text-[0.9375rem] text-white/75">
          {
            services.map((s) => (
              <li>
                <a href={serviceHref(s)} class="link-line hover:text-white">
                  {s.navTitle}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="grid grid-cols-2 gap-10 lg:col-span-3 lg:grid-cols-1">
        <nav aria-label="Company">
          <p class="eyebrow text-white/45">Company</p>
          <ul class="mt-7 grid gap-3 text-[0.9375rem] text-white/75">
            {
              company.map((l) => (
                <li>
                  <a href={l.href} class="link-line hover:text-white">
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <address class="not-italic">
          <p class="eyebrow text-white/45">Contact</p>
          <ul class="mt-7 grid gap-3 text-[0.9375rem] text-white/75">
            <li><a href={site.contact.phoneHref} class="link-line hover:text-white">{site.contact.phoneDisplay}</a></li>
            <li><a href={`mailto:${site.contact.email}`} class="link-line break-all hover:text-white">{site.contact.email}</a></li>
            <li class="text-white/55">{a.street}<br />{a.city}, {a.region}</li>
          </ul>
        </address>
      </div>
    </div>

    <div class="mt-24 flex flex-col gap-4 border-t border-white/10 pt-8 text-[0.8125rem] text-white/45 md:flex-row md:items-center md:justify-between">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p class="md:text-center">Selected widescreen background visuals remain temporary placeholders pending official landscape photography.</p>
      <a href="/privacy" class="link-line hover:text-white">Privacy Notice</a>
    </div>
  </div>
</footer>
