---
import { Image } from 'astro:assets';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';
import { ctas } from '@/data/navigation';
import crew from '@/assets/images/placeholder/gallery-demolition.jpg';
---

<section class="relative isolate flex min-h-[92svh] items-end overflow-hidden bg-ink text-white" aria-labelledby="careers-heading">
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute inset-x-0 -inset-y-[14%]" data-parallax="10">
      <Image src={crew} alt="" widths={[768, 1264]} sizes="100vw" class="h-full w-full object-cover object-[70%_50%]" quality={70} />
    </div>
    <div class="absolute inset-0 bg-ink/60" aria-hidden="true"></div>
    <div class="careers-shade absolute inset-0" aria-hidden="true"></div>
  </div>

  <div class="container-x py-24 md:py-32">
    <div class="grid gap-y-12 lg:grid-cols-12 lg:gap-x-10">
      <div class="lg:col-span-7">
        <Eyebrow index="06" tone="light">Careers</Eyebrow>
        <h2 id="careers-heading" class="display-lg mt-10" data-reveal="lines">Join a crew that takes pride in the work.</h2>
      </div>
      <div class="flex flex-col justify-end lg:col-span-4 lg:col-start-9">
        <p class="lede text-white/75" data-reveal="fade">
          We're looking for reliable, safety-minded people for restoration, cleaning and project-based work across Calgary.
          Apply online and upload your résumé in minutes.
        </p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row" data-reveal="fade">
          <Button href={ctas.apply.href} variant="primary">{ctas.apply.label}</Button>
          <Button href="/careers" variant="outline-light">Job opportunities</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .careers-shade {
    background: linear-gradient(0deg, rgb(14 20 37 / 0.85) 0%, rgb(14 20 37 / 0) 60%);
  }
</style>
