---
import { Image } from 'astro:assets';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';
import { services, serviceHref } from '@/data/services';
---

<section class="section-y relative border-t border-rule bg-paper" aria-labelledby="services-heading" data-services>
  <div class="container-x">
    <div class="grid gap-y-10 lg:grid-cols-12 lg:gap-x-10">
      <div class="lg:col-span-5">
        <Eyebrow index="02">Services</Eyebrow>
      </div>
      <div class="lg:col-span-7">
        <h2 id="services-heading" class="display-lg" data-reveal="lines">Six services. One dependable team on site.</h2>
        <p class="lede mt-8 max-w-[36rem] text-ink-500" data-reveal="fade">
          From emergency restoration labour to recurring janitorial contracts, each service is built around operational and
          project-specific requirements.
        </p>
      </div>
    </div>

    <div class="mt-20 grid md:mt-28 lg:grid-cols-12 lg:gap-x-10">
      <!-- Sticky visual (desktop) -->
      <div class="hidden lg:col-span-5 lg:block">
        <div class="sticky top-[calc(var(--header-h)+2rem)] h-[calc(100vh-var(--header-h)-4rem)] max-h-[760px]">
          <div class="relative h-full w-full overflow-hidden bg-ink" data-services-stage>
            {
              services.map((s, i) => (
                <div class="svc-frame absolute inset-0" data-svc-frame={i} style={i === 0 ? '' : 'clip-path: inset(100% 0 0 0)'}>
                  <Image
                    src={s.image}
                    alt=""
                    widths={[480, 768]}
                    sizes="(min-width: 1024px) 40vw, 100vw"
                    class="h-full w-full object-cover"
                    style={`object-position: ${s.imagePosition ?? '50% 35%'}`}
                    quality={80}
                    loading={i < 2 ? 'eager' : 'lazy'}
                  />
                </div>
              ))
            }
            <div
              class="pointer-events-none absolute inset-x-0 bottom-0 z-10 flex items-end justify-between bg-gradient-to-t from-ink/80 via-ink/25 to-transparent p-7 pt-20 text-white"
              aria-hidden="true"
            >
              <span class="index-num">
                <span data-svc-count>01</span>
                <span class="text-white/55"> / 06</span>
              </span>
              <span class="text-[0.75rem] uppercase tracking-[0.18em] text-white/65">QGS field operations</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Editorial list -->
      <ol class="lg:col-span-7">
        {
          services.map((s, i) => (
            <li class="svc-item border-t border-rule py-14 first:border-t-0 first:pt-0 md:py-20 lg:min-h-[78vh] lg:py-24 lg:first:pt-0" data-svc-item={i}>
              <figure class="mb-10 overflow-hidden lg:hidden" data-reveal="image">
                <Image
                  src={s.image}
                  alt={s.imageAlt}
                  widths={[480, 768]}
                  sizes="100vw"
                  class="aspect-[4/5] max-h-[540px] w-full object-cover"
                  style={`object-position: ${s.imagePosition ?? '50% 35%'}`}
                  quality={80}
                  loading="lazy"
                />
              </figure>
              <div class="flex items-baseline gap-6 md:gap-10">
                <span class="index-num svc-index pt-2 text-ink-400 transition-colors duration-500">{s.index}</span>
                <div class="min-w-0 flex-1">
                  <h3 class="display-sm max-w-[20ch]">
                    <a href={serviceHref(s)} class="hover:text-signal transition-colors duration-500">
                      {s.title}
                    </a>
                  </h3>
                  <p class="mt-6 max-w-[34rem] text-ink-500">{s.summary}</p>
                  {s.note && <p class="mt-4 max-w-[34rem] text-[0.875rem] text-ink-400">{s.note}</p>}
                  {s.scope.length > 0 && (
                    <ul class="mt-8 grid max-w-[38rem] gap-x-8 text-[0.9375rem] text-ink-700 sm:grid-cols-2">
                      {s.scope.slice(0, 6).map((item) => (
                        <li class="border-b border-rule py-3">{item}</li>
                      ))}
                    </ul>
                  )}
                  <div class="mt-10">
                    <Button href={serviceHref(s)} variant="text-dark" aria-label={`Learn more about ${s.title}`}>
                      Learn more
                    </Button>
                  </div>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="mt-10 flex justify-end border-t border-rule pt-10">
      <Button href="/services" variant="outline-dark">View all services</Button>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '@/scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-services]');
  if (root) {
    const frames = Array.from(root.querySelectorAll<HTMLElement>('[data-svc-frame]'));
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-svc-item]'));
    const counter = root.querySelector<HTMLElement>('[data-svc-count]');
    const reduced = prefersReducedMotion();
    let active = 0;

    const activate = (i: number) => {
      if (i === active) return;
      const forward = i > active;
      const next = frames[i];
      const img = next.querySelector('img');
      frames.forEach((f, j) => (f.style.zIndex = j === i ? '3' : j === active ? '2' : '1'));
      if (reduced) {
        frames.forEach((f, j) => (f.style.clipPath = j === i ? 'inset(0 0 0 0)' : 'inset(100% 0 0 0)'));
      } else {
        gsap.fromTo(
          next,
          { clipPath: forward ? 'inset(100% 0% 0% 0%)' : 'inset(0% 0% 100% 0%)' },
          { clipPath: 'inset(0% 0% 0% 0%)', duration: 1.1, ease: 'expo.inOut', overwrite: true },
        );
        if (img) gsap.fromTo(img, { scale: 1.18 }, { scale: 1, duration: 1.6, ease: 'expo.out', overwrite: true });
      }
      items.forEach((it, j) => it.classList.toggle('is-active', j === i));
      if (counter) counter.textContent = String(i + 1).padStart(2, '0');
      active = i;
    };

    items[0]?.classList.add('is-active');
    const mm = gsap.matchMedia();
    mm.add('(min-width: 1024px)', () => {
      items.forEach((item, i) => {
        ScrollTrigger.create({
          trigger: item,
          start: 'top 55%',
          end: 'bottom 55%',
          onToggle: (self) => self.isActive && activate(i),
        });
      });
    });
  }
</script>

<style>
  .svc-item.is-active .svc-index {
    color: var(--color-signal);
  }
</style>
