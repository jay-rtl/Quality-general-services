---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';

import restoration from '@/assets/images/placeholder/service-restoration.jpg';
import hotel from '@/assets/images/placeholder/gallery-hotel.jpg';
import demolition from '@/assets/images/placeholder/gallery-demolition.jpg';
import equipment from '@/assets/images/placeholder/gallery-equipment.jpg';
import contents from '@/assets/images/placeholder/service-contents.jpg';
import commercial from '@/assets/images/placeholder/hero-commercial.jpg';

interface Item {
  image: ImageMetadata;
  alt: string;
  category: string;
  orientation: 'landscape' | 'portrait';
}

// Captions describe service types only — no project names, clients or locations
// until the client supplies verified project history.
const items: Item[] = [
  { image: restoration, alt: 'Placeholder: crew removing wet drywall after water damage', category: 'Water damage restoration support', orientation: 'landscape' },
  { image: hotel, alt: 'Placeholder: hotel corridor being vacuumed', category: 'Hospitality cleaning', orientation: 'portrait' },
  { image: demolition, alt: 'Placeholder: worker loading demolition debris into a bin', category: 'Demolition & site cleanup', orientation: 'landscape' },
  { image: equipment, alt: 'Placeholder: air movers and a dehumidifier drying a concrete floor', category: 'Structural drying support', orientation: 'portrait' },
  { image: contents, alt: 'Placeholder: furniture wrapped for a contents pack-out', category: 'Contents pack-out', orientation: 'landscape' },
  { image: commercial, alt: 'Placeholder: floor scrubber in an office atrium', category: 'Commercial floor care', orientation: 'landscape' },
];
---

<section class="gallery relative overflow-hidden bg-paper" aria-labelledby="gallery-heading" data-gallery>
  <div class="gallery-pin flex min-h-[100svh] flex-col justify-center py-16 sm:py-20 lg:pb-10 lg:pt-20" data-gallery-pin>
    <div class="container-x">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between md:gap-8">
        <div>
          <Eyebrow index="05">In the field</Eyebrow>
          <h2 id="gallery-heading" class="display-lg mt-6 md:mt-8" data-reveal="lines">Featured work</h2>
        </div>
        <div class="flex items-center gap-8" data-reveal="fade">
          <p class="hidden max-w-[22rem] text-[0.9375rem] text-ink-500 md:block">
            A look at the kinds of sites and services our crews support. Official project photography will replace these
            placeholders.
          </p>
          <Button href="/projects" variant="outline-dark" class="shrink-0">View projects</Button>
        </div>
      </div>
    </div>

    <div
      class="gallery-viewport mt-10 overflow-x-auto overscroll-x-contain md:mt-16 lg:mt-20 lg:overflow-visible"
      tabindex="0"
      aria-label="Featured work gallery — scroll horizontally"
      data-gallery-viewport
    >
      <ul class="gallery-track flex w-max items-end gap-5 px-[var(--gutter)] md:gap-8" data-gallery-track>
        {
          items.map((it, i) => (
            <li class="shrink-0 snap-start">
              <figure>
                <div class:list={['overflow-hidden bg-ink', it.orientation === 'portrait' ? 'h-[44svh] max-h-[640px] min-h-[290px] aspect-[3/4] lg:h-[52vh] lg:min-h-[340px]' : 'h-[36svh] max-h-[540px] min-h-[220px] aspect-[3/2] lg:h-[44vh] lg:min-h-[260px]']}>
                  <Image
                    src={it.image}
                    alt={it.alt}
                    widths={[480, 800, 1264]}
                    sizes="(min-width: 1024px) 40vw, 80vw"
                    class="gallery-img h-full w-full scale-110 object-cover"
                    quality={70}
                    data-gallery-img
                  />
                </div>
                <figcaption class="mt-4 flex items-baseline gap-4 text-[0.9375rem] lg:mt-5">
                  <span class="index-num text-ink-400">{String(i + 1).padStart(2, '0')}</span>
                  <span>{it.category}</span>
                </figcaption>
              </figure>
            </li>
          ))
        }
        <li class="flex shrink-0 snap-start items-center self-stretch pr-[var(--gutter)]">
          <a href="/projects" class="group/more flex h-[36svh] max-h-[540px] min-h-[220px] w-[min(70vw,22rem)] flex-col justify-between border-l border-rule pl-8 lg:h-[44vh] lg:min-h-[260px]">
            <span class="index-num text-ink-400">All work</span>
            <span class="display-sm transition-colors duration-500 group-hover/more:text-signal">View the full gallery →</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="gallery-progress-wrap container-x mt-8 hidden lg:mt-10 lg:block" aria-hidden="true">
      <div class="relative h-px bg-rule">
        <span class="absolute inset-y-0 left-0 w-full origin-left scale-x-0 bg-ink" data-gallery-progress></span>
      </div>
    </div>
  </div>
</section>

<style>
  .gallery-viewport {
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .gallery-viewport::-webkit-scrollbar {
    display: none;
  }
  .gallery[data-gallery-pinned='true'] .gallery-viewport {
    overflow: hidden;
    scroll-snap-type: none;
    touch-action: pan-y;
  }
  .gallery[data-gallery-pinned='true'] .gallery-track {
    will-change: transform;
  }
  .gallery[data-gallery-pinned='true'] .gallery-progress-wrap {
    display: block;
  }
  @media (min-width: 1024px) {
    .gallery-viewport {
      scroll-snap-type: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery-img {
      transform: none !important;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '@/scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-gallery]');
  if (root && !prefersReducedMotion()) {
    const pin = root.querySelector<HTMLElement>('[data-gallery-pin]')!;
    const viewport = root.querySelector<HTMLElement>('[data-gallery-viewport]')!;
    const track = root.querySelector<HTMLElement>('[data-gallery-track]')!;
    const progress = root.querySelector<HTMLElement>('[data-gallery-progress]');
    const imgs = root.querySelectorAll<HTMLElement>('[data-gallery-img]');
    const mm = gsap.matchMedia();

    // Prevent mobile browser address-bar resize from causing mid-scroll pin jumps.
    ScrollTrigger.config({ ignoreMobileResize: true });

    // Desktop (preserved unchanged): vertical scroll drives horizontal travel (pinned).
    mm.add('(min-width: 1024px)', () => {
      const distance = () => Math.max(0, track.scrollWidth - window.innerWidth);
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: pin,
          start: 'top top',
          end: () => `+=${distance()}`,
          pin: true,
          scrub: 0.8,
          invalidateOnRefresh: true,
          anticipatePin: 1,
        },
      });
      tl.to(track, { x: () => -distance(), ease: 'none' }, 0);
      if (progress) tl.to(progress, { scaleX: 1, ease: 'none' }, 0);
      imgs.forEach((img) => {
        tl.fromTo(img, { xPercent: -5 }, { xPercent: 5, ease: 'none' }, 0);
      });
    });

    // Mobile & tablet: vertical touch scroll drives smooth horizontal travel (pinned).
    mm.add('(max-width: 1023px)', () => {
      viewport.scrollLeft = 0;
      root.dataset.galleryPinned = 'true';

      const distance = () => Math.max(0, track.scrollWidth - viewport.clientWidth);
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: pin,
          start: 'top top',
          end: () => `+=${distance()}`,
          pin: true,
          pinSpacing: true,
          scrub: 0.6,
          invalidateOnRefresh: true,
          anticipatePin: 1,
        },
      });
      tl.to(track, { x: () => -distance(), ease: 'none' }, 0);
      if (progress) tl.to(progress, { scaleX: 1, ease: 'none' }, 0);
      imgs.forEach((img) => {
        tl.fromTo(img, { xPercent: -4 }, { xPercent: 4, ease: 'none' }, 0);
      });

      const onOrientation = () => ScrollTrigger.refresh();
      window.addEventListener('orientationchange', onOrientation);

      return () => {
        delete root.dataset.galleryPinned;
        window.removeEventListener('orientationchange', onOrientation);
      };
    });
  }
</script>
