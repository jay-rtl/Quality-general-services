---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';

import containment from '@/assets/images/client/qgs-containment-preparation.webp';
import packout from '@/assets/images/client/qgs-contents-packout-loading.webp';
import fireCleanup from '@/assets/images/client/fire-damage-restoration-cleanup.webp';
import carpetExtraction from '@/assets/images/client/commercial-carpet-extraction.webp';
import rooftopCrew from '@/assets/images/client/commercial-rooftop-cleanup-crew.webp';
import demoTile from '@/assets/images/client/interior-demolition-tile-removal.webp';
import siteCrew from '@/assets/images/client/restoration-crew-site-cleanup.webp';
import remediationTech from '@/assets/images/client/contained-remediation-technician.webp';

interface Item {
  image: ImageMetadata;
  alt: string;
  category: string;
  /** Staggered vertical frame height (all natural portrait ratios for 3:4 client photos) */
  frame: 'tall' | 'medium';
  position?: string;
}

// Captions describe visible service categories only — no unconfirmed project names or locations.
const items: Item[] = [
  { image: containment, alt: 'Quality General Services technician preparing sealed plastic containment sheeting', category: 'Site containment preparation', frame: 'tall', position: '50% 42%' },
  { image: packout, alt: 'Quality General Services crew loading wrapped contents from a cart into a truck', category: 'Contents pack-out & loading', frame: 'medium', position: '50% 35%' },
  { image: fireCleanup, alt: 'Crew in protective coveralls and respirators performing interior fire-damage cleanup', category: 'Fire & smoke restoration support', frame: 'tall', position: '50% 40%' },
  { image: carpetExtraction, alt: 'Technician performing commercial hallway carpet extraction', category: 'Commercial floor & carpet care', frame: 'medium', position: '50% 30%' },
  { image: rooftopCrew, alt: 'Two crew members in protective coveralls clearing debris on a commercial rooftop', category: 'Commercial rooftop cleanup', frame: 'tall', position: '50% 48%' },
  { image: demoTile, alt: 'Worker in safety vest and hard hat removing broken floor tile during interior demolition', category: 'Demolition & site cleanup', frame: 'medium', position: '50% 38%' },
  { image: siteCrew, alt: 'Multi-person crew in protective gear conducting exterior restoration site cleanup', category: 'Restoration crew support', frame: 'tall', position: '50% 35%' },
  { image: remediationTech, alt: 'Technician in protective coveralls and respirator working inside a contained area', category: 'Specialized remediation', frame: 'medium', position: '50% 32%' },
];
---

<section class="gallery relative overflow-x-clip bg-paper" aria-labelledby="gallery-heading" data-gallery>
  <div class="gallery-pin relative z-20 flex h-[100svh] min-h-[600px] flex-col justify-center overflow-hidden bg-paper py-12 sm:py-16 lg:pb-8 lg:pt-20" data-gallery-pin>
    <div class="container-x shrink-0">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between md:gap-8">
        <div>
          <Eyebrow index="05">In the field</Eyebrow>
          <h2 id="gallery-heading" class="display-lg mt-4 md:mt-6" data-reveal="lines">Featured work</h2>
        </div>
        <div class="flex items-center gap-8" data-reveal="fade">
          <p class="hidden max-w-[22rem] text-[0.9375rem] text-ink-500 md:block">
            Authentic on-site photography from our restoration support, contents handling, cleaning, and remediation
            crews.
          </p>
          <Button href="/projects" variant="outline-dark" class="shrink-0">View projects</Button>
        </div>
      </div>
    </div>

    <div
      class="gallery-viewport mt-8 overflow-x-auto overscroll-x-contain md:mt-10 lg:mt-12 lg:overflow-visible"
      tabindex="0"
      aria-label="Featured work gallery — scroll horizontally"
      data-gallery-viewport
    >
      <ul class="gallery-track flex w-max items-end gap-5 px-[var(--gutter)] md:gap-8" data-gallery-track>
        {
          items.map((it, i) => (
            <li class="shrink-0 snap-start">
              <figure>
                <div
                  class:list={[
                    'overflow-hidden bg-ink',
                    it.frame === 'tall'
                      ? 'h-[42svh] max-h-[540px] min-h-[240px] aspect-[3/4] lg:h-[48svh] lg:max-h-[560px]'
                      : 'h-[35svh] max-h-[460px] min-h-[205px] aspect-[4/5] lg:h-[40svh] lg:max-h-[470px]',
                  ]}
                >
                  <Image
                    src={it.image}
                    alt={it.alt}
                    widths={[400, 768]}
                    sizes="(min-width: 1024px) 32vw, 72vw"
                    class="gallery-img h-full w-full scale-110 object-cover"
                    style={`object-position: ${it.position ?? '50% 40%'}`}
                    quality={80}
                    loading="lazy"
                    data-gallery-img
                  />
                </div>
                <figcaption class="mt-3 flex items-baseline gap-4 text-[0.9375rem] lg:mt-4">
                  <span class="index-num text-ink-400">{String(i + 1).padStart(2, '0')}</span>
                  <span>{it.category}</span>
                </figcaption>
              </figure>
            </li>
          ))
        }
        <li class="flex shrink-0 snap-start items-center self-stretch pr-[var(--gutter)]">
          <a href="/projects" class="group/more flex h-[35svh] max-h-[460px] min-h-[205px] w-[min(70vw,22rem)] flex-col justify-between border-l border-rule pl-8 lg:h-[40svh] lg:max-h-[470px]">
            <span class="index-num text-ink-400">All work</span>
            <span class="display-sm transition-colors duration-500 group-hover/more:text-signal">View the full gallery →</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="gallery-progress-wrap container-x mt-6 hidden shrink-0 lg:mt-8 lg:block" aria-hidden="true">
      <div class="relative h-px bg-rule">
        <span class="absolute inset-y-0 left-0 w-full origin-left scale-x-0 bg-ink" data-gallery-progress></span>
      </div>
    </div>
  </div>
</section>

<style>
  .gallery-viewport {
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .gallery-viewport::-webkit-scrollbar {
    display: none;
  }
  .gallery[data-gallery-pinned='true'] .gallery-viewport {
    overflow: hidden;
    scroll-snap-type: none;
    touch-action: pan-y;
  }
  .gallery[data-gallery-pinned='true'] .gallery-track {
    will-change: transform;
  }
  .gallery[data-gallery-pinned='true'] .gallery-progress-wrap {
    display: block;
  }
  @media (min-width: 1024px) {
    .gallery-viewport {
      scroll-snap-type: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery-img {
      transform: none !important;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '@/scripts/motion';

  async function initGallery() {
    const root = document.querySelector<HTMLElement>('[data-gallery]');
    if (!root || prefersReducedMotion()) return;

    const pin = root.querySelector<HTMLElement>('[data-gallery-pin]');
    const viewport = root.querySelector<HTMLElement>('[data-gallery-viewport]');
    const track = root.querySelector<HTMLElement>('[data-gallery-track]');
    if (!pin || !viewport || !track) return;

    const progress = root.querySelector<HTMLElement>('[data-gallery-progress]');
    const imgs = root.querySelectorAll<HTMLElement>('[data-gallery-img]');

    // Wait for fonts so container and caption heights are final before measuring pin distance.
    try {
      await Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 1200))]);
    } catch {
      /* ignore */
    }

    // Prevent mobile browser address-bar resize from causing mid-scroll pin jumps.
    ScrollTrigger.config({ ignoreMobileResize: true });

    const mm = gsap.matchMedia();

    // Desktop: vertical scroll drives horizontal travel (pinned).
    mm.add('(min-width: 1024px)', () => {
      viewport.scrollLeft = 0;
      const distance = () => Math.max(0, track.scrollWidth - viewport.clientWidth);
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: pin,
          start: 'top top',
          end: () => `+=${distance()}`,
          pin: true,
          pinSpacing: true,
          scrub: 0.7,
          invalidateOnRefresh: true,
          anticipatePin: 1,
          refreshPriority: 1,
        },
      });
      tl.to(track, { x: () => -distance(), ease: 'none' }, 0);
      if (progress) tl.to(progress, { scaleX: 1, ease: 'none' }, 0);
      imgs.forEach((img) => {
        tl.fromTo(img, { xPercent: -5 }, { xPercent: 5, ease: 'none' }, 0);
      });
    });

    // Mobile & tablet: vertical touch scroll drives smooth horizontal travel (pinned).
    mm.add('(max-width: 1023px)', () => {
      viewport.scrollLeft = 0;
      root.dataset.galleryPinned = 'true';

      const distance = () => Math.max(0, track.scrollWidth - viewport.clientWidth);
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: pin,
          start: 'top top',
          end: () => `+=${distance()}`,
          pin: true,
          pinSpacing: true,
          scrub: 0.6,
          invalidateOnRefresh: true,
          anticipatePin: 1,
          refreshPriority: 1,
        },
      });
      tl.to(track, { x: () => -distance(), ease: 'none' }, 0);
      if (progress) tl.to(progress, { scaleX: 1, ease: 'none' }, 0);
      imgs.forEach((img) => {
        tl.fromTo(img, { xPercent: -4 }, { xPercent: 4, ease: 'none' }, 0);
      });

      const onOrientation = () => ScrollTrigger.refresh();
      window.addEventListener('orientationchange', onOrientation);

      return () => {
        delete root.dataset.galleryPinned;
        window.removeEventListener('orientationchange', onOrientation);
      };
    });

    // Re-measure if track width changes (e.g. viewport resize or lazy image load).
    let refreshTimer: number | undefined;
    const scheduleRefresh = () => {
      window.clearTimeout(refreshTimer);
      refreshTimer = window.setTimeout(() => ScrollTrigger.refresh(), 120);
    };
    const ro = new ResizeObserver(scheduleRefresh);
    ro.observe(track);

    ScrollTrigger.sort();
    ScrollTrigger.refresh();
  }

  initGallery();
</script>
