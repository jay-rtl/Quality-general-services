---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import { ctas } from '@/data/navigation';
import { site } from '@/config/site';

import heroRestoration from '@/assets/images/placeholder/hero-restoration.jpg';
import heroCommercial from '@/assets/images/placeholder/hero-commercial.jpg';
import heroConstruction from '@/assets/images/placeholder/hero-construction.jpg';
import heroRemediation from '@/assets/images/placeholder/hero-remediation.jpg';

interface Slide {
  image: ImageMetadata;
  alt: string;
  caption: string;
  /** focal point for object-position on narrow screens */
  focus?: string;
}

interface Props {
  /**
   * Optional looping background video (client footage). When provided it replaces
   * the image sequence; the first slide remains the poster / static fallback.
   */
  video?: { mp4?: string; webm?: string };
}
const { video } = Astro.props;

const slides: Slide[] = [
  { image: heroRestoration, alt: 'Placeholder: technician checking moisture in a water-damaged interior with drying equipment', caption: 'Restoration support', focus: '72% 50%' },
  { image: heroCommercial, alt: 'Placeholder: cleaning professional operating a floor scrubber in an office atrium at dusk', caption: 'Commercial cleaning', focus: '74% 50%' },
  { image: heroConstruction, alt: 'Placeholder: crew cleaning a newly finished commercial interior', caption: 'Post-construction cleaning', focus: '78% 50%' },
  { image: heroRemediation, alt: 'Placeholder: remediation technicians working inside plastic containment', caption: 'Specialized remediation', focus: '70% 50%' },
];

const optimized = await Promise.all(
  slides.map(async (s) => {
    const widths = [640, 960, 1376];
    const imgs = await Promise.all(widths.map((w) => getImage({ src: s.image, width: w, format: 'webp', quality: 72 })));
    return {
      ...s,
      src: imgs[imgs.length - 1].src,
      srcset: imgs.map((img, i) => `${img.src} ${widths[i]}w`).join(', '),
    };
  }),
);
---

<section
  class="hero relative isolate flex h-[100svh] min-h-[640px] flex-col overflow-hidden bg-ink text-white"
  aria-label="Introduction"
  data-hero
  data-hero-video={video ? 'true' : 'false'}
>
  <!-- Background -->
  <div class="hero-media absolute inset-0 -z-10" data-hero-media>
    {
      video ? (
        <video
          class="absolute inset-0 h-full w-full object-cover"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={optimized[0].src}
          aria-hidden="true"
          data-hero-videoel
        >
          {video.webm && <source src={video.webm} type="video/webm" />}
          {video.mp4 && <source src={video.mp4} type="video/mp4" />}
        </video>
      ) : (
        optimized.map((s, i) => (
          <div class="hero-slide absolute inset-0" data-hero-slide data-caption={s.caption} style={i === 0 ? '' : 'opacity:0;visibility:hidden'}>
            <img
              src={s.src}
              srcset={s.srcset}
              sizes="100vw"
              alt={i === 0 ? s.alt : ''}
              aria-hidden={i === 0 ? undefined : 'true'}
              width={s.image.width}
              height={s.image.height}
              class="hero-img absolute inset-0 h-full w-full object-cover"
              style={`object-position:${s.focus ?? '50% 50%'}`}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              decoding={i === 0 ? 'sync' : 'async'}
            />
          </div>
        ))
      )
    }
    <!-- Readability overlay: flat tone + directional shade, no decorative gradients -->
    <div class="absolute inset-0 bg-ink/45" aria-hidden="true"></div>
    <div class="hero-shade absolute inset-0" aria-hidden="true"></div>
  </div>

  <!-- Content -->
  <div class="container-x relative flex flex-1 flex-col justify-end pb-[clamp(7rem,16vh,11rem)] pt-[calc(var(--header-h)+3rem)]" data-hero-content>
    <div class="max-w-[62rem]">
      <p class="eyebrow mb-8 flex items-center gap-3 text-white/75 md:mb-10" data-hero-intro>
        <span class="inline-block size-1.5 rounded-full bg-brand" aria-hidden="true"></span>
        Calgary, Alberta
      </p>
      <h1 class="display-xl text-balance" data-hero-title>
        <span class="block">Built on Experience.</span>
        <span class="block text-white/55">Driven by Quality.</span>
      </h1>
      <p class="lede mt-8 max-w-[34rem] text-white/80 md:mt-10" data-hero-intro>
        Professional restoration support, commercial cleaning, and workforce solutions across {site.serviceArea}.
      </p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:gap-4 md:mt-12" data-hero-intro>
        <Button href={ctas.quote.href} variant="primary" class="sm:min-w-[15rem]">{ctas.quote.label}</Button>
        <Button href={ctas.services.href} variant="outline-light" class="sm:min-w-[15rem]">{ctas.services.label}</Button>
      </div>
    </div>
  </div>

  <!-- Bottom rail: scene caption + progress (decorative, mirrors slide state) -->
  {
    !video && (
      <div class="absolute inset-x-0 bottom-0" data-hero-intro aria-hidden="true">
        <div class="container-x flex items-end justify-between gap-6 pb-8 md:pb-10">
          <a href="#intro" class="hidden items-center gap-4 text-[0.8125rem] text-white/60 transition-colors hover:text-white md:flex" tabindex="-1">
            <span class="scroll-cue relative block h-10 w-px overflow-hidden bg-white/20">
              <span class="absolute inset-x-0 top-0 h-1/2 bg-white" />
            </span>
            Scroll
          </a>
          <div class="ml-auto flex w-full max-w-[22rem] flex-col gap-3">
            <div class="flex items-baseline justify-between text-[0.8125rem]">
              <span class="overflow-hidden">
                <span class="block text-white/85" data-hero-caption>{slides[0].caption}</span>
              </span>
              <span class="index-num text-white/50">
                <span data-hero-count>01</span> / {String(slides.length).padStart(2, '0')}
              </span>
            </div>
            <div class="grid grid-cols-4 gap-2">
              {slides.map(() => (
                <span class="relative block h-px overflow-hidden bg-white/20">
                  <span class="absolute inset-0 origin-left scale-x-0 bg-white" data-hero-bar />
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    )
  }
</section>

<style>
  .hero-shade {
    /* Directional shade only behind the left-aligned type for legibility */
    background:
      linear-gradient(90deg, rgb(14 20 37 / 0.78) 0%, rgb(14 20 37 / 0.35) 45%, rgb(14 20 37 / 0) 75%),
      linear-gradient(0deg, rgb(14 20 37 / 0.7) 0%, rgb(14 20 37 / 0) 40%);
  }
  .hero-img {
    transform-origin: 60% 50%;
    will-change: transform;
  }
  .scroll-cue span {
    animation: cue 2.4s var(--ease-cine) infinite;
  }
  @keyframes cue {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(200%);
    }
  }
</style>

<script>
  import { initHero } from '@/scripts/hero';
  initHero();
</script>
