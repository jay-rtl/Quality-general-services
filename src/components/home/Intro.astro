---
import { Image } from 'astro:assets';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';
import detail from '@/assets/images/placeholder/intro-detail.jpg';
---

<section id="intro" class="section-y relative bg-paper" aria-labelledby="intro-heading">
  <div class="container-x">
    <div class="grid gap-y-12 lg:grid-cols-12 lg:gap-x-10">
      <div class="lg:col-span-3">
        <Eyebrow index="01">Who we are</Eyebrow>
        <dl class="mt-10 hidden space-y-6 text-[0.9375rem] lg:block" data-reveal="fade">
          <div>
            <dt class="text-ink-400">Established</dt>
            <dd class="mt-1">{site.established}</dd>
          </div>
          <div>
            <dt class="text-ink-400">Based in</dt>
            <dd class="mt-1">Calgary, Alberta</dd>
          </div>
          <div>
            <dt class="text-ink-400">Serving</dt>
            <dd class="mt-1">{site.serviceArea}</dd>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-9">
        <h2 id="intro-heading" class="sr-only">About Quality General Services</h2>
        <p class="display-md max-w-[22ch] text-ink lg:max-w-none" data-reveal="words">
          We partner with restoration companies, general contractors, property managers and commercial organizations to
          deliver integrated cleaning, restoration support, specialized remediation and workforce solutions.
        </p>
      </div>
    </div>

    <div class="mt-24 grid items-end gap-y-12 md:mt-36 lg:grid-cols-12 lg:gap-x-10">
      <figure class="overflow-hidden lg:col-span-7 lg:col-start-1" data-reveal="image" data-from="left">
        <Image
          src={detail}
          alt="Placeholder: gloved hands wiping a stainless steel surface"
          widths={[640, 960, 1376]}
          sizes="(min-width: 1024px) 58vw, 100vw"
          class="aspect-[16/10] w-full object-cover"
          quality={72}
        />
      </figure>
      <div class="lg:col-span-4 lg:col-start-9 lg:pb-4">
        <p class="lede text-ink-500" data-reveal="fade">
          Our hands-on experience in the restoration industry, reliable workforce and flexible staffing mean we understand
          the demands of restoration and commercial projects, and work closely with clients to meet their operational
          needs.
        </p>
        <div class="mt-10" data-reveal="fade">
          <Button href="/about" variant="text-dark">More about QGS</Button>
        </div>
      </div>
    </div>
  </div>
</section>
