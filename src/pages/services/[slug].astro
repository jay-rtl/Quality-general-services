---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/layout/PageHero.astro';
import CtaBand from '@/components/layout/CtaBand.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';
import { services, serviceHref, type Service } from '@/data/services';
import { advantages } from '@/data/company';
import { site } from '@/config/site';

export const getStaticPaths = (() =>
  services.map((service, idx) => ({
    params: { slug: service.slug },
    props: {
      service,
      prev: services[(idx - 1 + services.length) % services.length],
      next: services[(idx + 1) % services.length],
    },
  }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
  prev: Service;
  next: Service;
}

const { service, prev, next } = Astro.props;
const quoteHref = `/contact?service=${service.formValue}#quote`;
---

<BaseLayout title={service.title} description={service.summary} transparentHeader>
  <PageHero
    eyebrow="Service"
    index={service.index}
    title={service.title}
    lede={service.summary}
    backHref="/services"
    backLabel="All services"
    image={service.heroImage}
    imageAlt={service.heroImageAlt}
  >
    <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:gap-4" data-reveal="fade">
      <Button href={quoteHref} variant="primary">Request a Quote</Button>
      <Button href={site.contact.phoneHref} variant="outline-light">Call {site.contact.phoneDisplay}</Button>
    </div>

    <dl slot="meta" class="grid grid-cols-2 gap-6 border-t border-white/15 pt-6 text-[0.9375rem] lg:grid-cols-1" data-reveal="fade">
      <div>
        <dt class="eyebrow text-white/50">Service area</dt>
        <dd class="mt-2 text-white">{site.serviceArea}</dd>
      </div>
      <div>
        <dt class="eyebrow text-white/50">Direct inquiry</dt>
        <dd class="mt-2"><a href={`mailto:${site.contact.email}`} class="link-line break-all text-white">{site.contact.email}</a></dd>
      </div>
    </dl>
  </PageHero>

  <!-- Main scope & editorial overview -->
  <section class="section-y bg-paper" aria-labelledby="scope-heading">
    <div class="container-x">
      <div class="grid gap-y-16 lg:grid-cols-12 lg:gap-x-10">
        <div class="lg:col-span-5">
          <Eyebrow index="01">Scope of work</Eyebrow>
          <h2 id="scope-heading" class="display-md mt-8 max-w-[16ch]" data-reveal="lines">
            {service.scope.length > 0 ? 'What this service includes.' : 'Tailored to your site requirements.'}
          </h2>
          <p class="mt-6 max-w-[28rem] text-ink-500" data-reveal="fade">
            {service.summary}
          </p>
          {
            service.note && (
              <p class="mt-6 max-w-[28rem] border-l-2 border-signal pl-4 text-[0.9375rem] text-ink-700" data-reveal="fade">
                {service.note}
              </p>
            )
          }
          <div class="mt-10" data-reveal="fade">
            <Button href={quoteHref} variant="primary">Request a Quote</Button>
          </div>
        </div>

        <div class="lg:col-span-6 lg:col-start-7">
          {
            service.scope.length > 0 ? (
              <div class="space-y-12">
                <ol class="border-t border-rule" data-stagger>
                  {service.scope.map((item, i) => (
                    <li class="flex items-baseline gap-6 border-b border-rule py-6">
                      <span class="index-num text-ink-400">{String(i + 1).padStart(2, '0')}</span>
                      <span class="text-[1.125rem] font-medium text-ink">{item}</span>
                    </li>
                  ))}
                </ol>
                <figure class="max-w-[30rem] overflow-hidden" data-reveal="image">
                  <Image
                    src={service.image}
                    alt={service.imageAlt}
                    widths={[480, 768]}
                    sizes="(min-width: 1024px) 38vw, 100vw"
                    class="aspect-[4/5] max-h-[560px] w-full object-cover"
                    style={`object-position: ${service.imagePosition ?? '50% 35%'}`}
                    quality={80}
                    loading="lazy"
                  />
                  <figcaption class="mt-3 text-[0.8125rem] text-ink-400">QGS field operations — {service.navTitle}</figcaption>
                </figure>
              </div>
            ) : (
              <div class="space-y-8 border-t border-rule pt-8" data-reveal="fade">
                <p class="lede text-ink">
                  Every site has different operational, safety, and scheduling requirements. We coordinate directly with
                  your project leads, property managers, or general contractors to define scope and crew needs before
                  mobilization.
                </p>
                <figure class="max-w-[32rem] overflow-hidden" data-reveal="image">
                  <Image
                    src={service.image}
                    alt={service.imageAlt}
                    widths={[480, 768]}
                    sizes="(min-width: 1024px) 40vw, 100vw"
                    class="aspect-[4/5] max-h-[580px] w-full object-cover"
                    style={`object-position: ${service.imagePosition ?? '50% 35%'}`}
                    quality={80}
                    loading="lazy"
                  />
                </figure>
                <p class="text-[0.8125rem] text-ink-400">QGS field operations — {service.navTitle}</p>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- How QGS works on site -->
  <section class="section-y border-t border-rule bg-bone" aria-labelledby="standards-heading">
    <div class="container-x">
      <div class="grid gap-y-12 lg:grid-cols-12 lg:gap-x-10">
        <div class="lg:col-span-4">
          <Eyebrow index="02">Our standard</Eyebrow>
          <h2 id="standards-heading" class="display-md mt-8 max-w-[14ch]" data-reveal="lines">
            Hands-on reliability on every site.
          </h2>
        </div>
        <ol class="lg:col-span-7 lg:col-start-6">
          {
            advantages.map((a, i) => (
              <li class="grid gap-4 border-t border-ink/12 py-8 md:grid-cols-12 md:gap-8" data-reveal="fade">
                <span class="index-num text-ink-400 md:col-span-2">{String(i + 1).padStart(2, '0')}</span>
                <div class="md:col-span-10">
                  <h3 class="display-sm">{a.title}</h3>
                  <p class="mt-3 text-ink-500">{a.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Prev / Next service navigation -->
  <nav aria-label="Other services" class="border-t border-rule bg-paper">
    <div class="container-x grid divide-y divide-rule md:grid-cols-2 md:divide-x md:divide-y-0">
      <a href={serviceHref(prev)} class="group flex flex-col justify-between gap-6 py-12 md:pr-10 md:py-16">
        <span class="eyebrow text-ink-400">← Previous service ({prev.index})</span>
        <span class="display-sm transition-colors duration-500 group-hover:text-signal">{prev.title}</span>
      </a>
      <a href={serviceHref(next)} class="group flex flex-col justify-between gap-6 py-12 md:items-end md:pl-10 md:py-16 md:text-right">
        <span class="eyebrow text-ink-400">Next service ({next.index}) →</span>
        <span class="display-sm transition-colors duration-500 group-hover:text-signal">{next.title}</span>
      </a>
    </div>
  </nav>

  <CtaBand
    tone="ink"
    eyebrow="Request a quote"
    title={`Discuss ${service.navTitle.toLowerCase()} for your site.`}
    body="Tell us your project location, timeline and requirements. We'll respond promptly."
    primaryHref={quoteHref}
    primaryLabel="Request a Quote"
    secondaryHref="/services"
    secondaryLabel="All Services"
  />
</BaseLayout>
