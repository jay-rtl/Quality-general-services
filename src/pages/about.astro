---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/layout/PageHero.astro';
import CtaBand from '@/components/layout/CtaBand.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';
import { advantages } from '@/data/company';
import { ctas } from '@/data/navigation';

import heroImg from '@/assets/images/placeholder/hero-construction.jpg';
import detailImg from '@/assets/images/placeholder/intro-detail.jpg';
import containmentImg from '@/assets/images/client/qgs-containment-preparation.webp';
---

<BaseLayout
  title="About Us"
  description="Quality General Services (QGS) is a Calgary-based service provider established in 2023, bringing nearly 20 years of combined hands-on restoration and on-site experience."
  transparentHeader
>
  <PageHero
    eyebrow="About QGS"
    index="01"
    title="Built on practical, on-site experience."
    lede="Established in 2023 in Calgary, backed by nearly two decades of combined hands-on work in restoration and construction environments."
    image={heroImg}
    imageAlt="Placeholder: workers cleaning a newly finished commercial interior"
  >
    <dl slot="meta" class="grid grid-cols-2 gap-6 border-t border-white/15 pt-6 text-[0.9375rem] lg:grid-cols-1" data-reveal="fade">
      <div>
        <dt class="eyebrow text-white/50">Established</dt>
        <dd class="mt-2 text-white">{site.established}</dd>
      </div>
      <div>
        <dt class="eyebrow text-white/50">Service area</dt>
        <dd class="mt-2 text-white">{site.serviceArea}</dd>
      </div>
    </dl>
  </PageHero>

  <!-- Company Background -->
  <section class="section-y bg-paper" aria-labelledby="bg-heading">
    <div class="container-x">
      <div class="grid gap-y-12 lg:grid-cols-12 lg:gap-x-10">
        <div class="lg:col-span-4">
          <Eyebrow index="01">Company background</Eyebrow>
        </div>
        <div class="lg:col-span-8">
          <h2 id="bg-heading" class="display-md max-w-[20ch]" data-reveal="lines">
            Dependable results for project-based work and ongoing facility needs.
          </h2>
          <div class="mt-10 grid gap-6 text-ink-500 md:grid-cols-2 md:gap-10" data-reveal="fade">
            <p class="lede text-ink">
              {site.name} ({site.shortName}) is a Calgary-based service provider established in {site.established},
              delivering commercial cleaning, post-construction cleaning, restoration support, specialized site services,
              and workforce solutions across {site.serviceArea}.
            </p>
            <div class="space-y-6">
              <p>
                We work alongside general contractors, restoration companies, business owners, and property managers to
                deliver dependable results for both project-based work and ongoing facility maintenance needs.
              </p>
              <p>
                Our commitment is to provide quality workmanship, reliable service, clear communication, and efficient
                project support while building lasting relationships with our clients and business partners.
              </p>
            </div>
          </div>
        </div>
      </div>

      <figure class="mt-20 md:mt-28">
        <div class="overflow-hidden" data-reveal="image">
          <Image
            src={detailImg}
            alt="Placeholder: gloved hands wiping a stainless steel surface"
            widths={[640, 1024, 1376]}
            sizes="100vw"
            class="aspect-[21/9] w-full object-cover"
            quality={72}
          />
        </div>
        <figcaption class="mt-4 flex justify-between text-[0.8125rem] text-ink-400">
          <span>Attention to detail across commercial and restoration sites</span>
          <span>Placeholder image</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Mission -->
  <section class="section-y border-t border-rule bg-bone" aria-labelledby="mission-heading">
    <div class="container-x">
      <div class="grid gap-y-10 lg:grid-cols-12 lg:gap-x-10">
        <div class="lg:col-span-3">
          <Eyebrow index="02">Our mission</Eyebrow>
        </div>
        <div class="lg:col-span-9">
          <h2 id="mission-heading" class="sr-only">Our Mission</h2>
          <p class="display-md text-ink" data-reveal="words">
            {site.mission}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Leadership & Industry Experience -->
  <section class="section-y bg-ink text-white" aria-labelledby="leadership-heading">
    <div class="container-x">
      <div class="grid gap-y-16 lg:grid-cols-12 lg:gap-x-10">
        <div class="lg:col-span-5">
          <Eyebrow index="03" tone="light">Leadership &amp; experience</Eyebrow>
          <h2 id="leadership-heading" class="display-lg mt-10" data-reveal="lines">
            Nearly 20 years of combined hands-on experience.
          </h2>
          <dl class="mt-12 grid gap-px bg-white/10 sm:grid-cols-2" data-stagger>
            <div class="bg-ink py-6 pr-6">
              <dt class="display-sm">10+ years</dt>
              <dd class="mt-2 text-[0.9375rem] text-white/60">{site.experience.partnerA}</dd>
            </div>
            <div class="bg-ink py-6 sm:pl-6">
              <dt class="display-sm">~10 years</dt>
              <dd class="mt-2 text-[0.9375rem] text-white/60">{site.experience.partnerB}</dd>
            </div>
          </dl>
        </div>

        <div class="lg:col-span-6 lg:col-start-7">
          <figure class="max-w-[32rem] overflow-hidden" data-reveal="image">
            <Image
              src={containmentImg}
              alt="Quality General Services technician preparing sealed plastic containment sheeting inside a work area"
              widths={[480, 768]}
              sizes="(min-width: 1024px) 42vw, 100vw"
              class="aspect-[4/5] max-h-[580px] w-full object-cover object-[50%_42%]"
              quality={80}
              loading="lazy"
            />
          </figure>
          <div class="mt-12 space-y-6 text-white/75" data-reveal="fade">
            <p class="lede text-white">
              Although Quality General Services was established in 2023, our two business partners bring nearly 20 years
              of combined hands-on experience—with one partner contributing over 10 years in the restoration industry and
              the other bringing nearly 10 years of practical, on-site experience.
            </p>
            <p>
              Our background includes working in demanding restoration and construction environments where attention to
              detail, safety, compliance, and reliability are essential. This practical foundation gives our leadership
              team a strong command of project requirements, site coordination, cleaning procedures, workforce
              management, and quality standards.
            </p>
            <p>
              We bring this hands-on knowledge to every site, ensuring our clients receive dependable service,
              professional workmanship, and consistent attention to detail.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What Makes QGS Different -->
  <section class="section-y bg-paper" aria-labelledby="diff-heading">
    <div class="container-x">
      <div class="grid gap-y-12 lg:grid-cols-12 lg:gap-x-10">
        <div class="lg:col-span-4">
          <Eyebrow index="04">Why QGS</Eyebrow>
          <h2 id="diff-heading" class="display-md mt-8 max-w-[14ch]" data-reveal="lines">What makes us different.</h2>
          <div class="mt-10" data-reveal="fade">
            <Button href={ctas.services.href} variant="outline-dark">{ctas.services.label}</Button>
          </div>
        </div>
        <ol class="lg:col-span-7 lg:col-start-6">
          {
            advantages.map((a, i) => (
              <li class="grid gap-4 border-t border-rule py-9 md:grid-cols-12 md:gap-8" data-reveal="fade">
                <span class="index-num text-ink-400 md:col-span-2">{String(i + 1).padStart(2, '0')}</span>
                <div class="md:col-span-10">
                  <h3 class="display-sm">{a.title}</h3>
                  <p class="mt-4 max-w-[34rem] text-ink-500">{a.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Work with us"
    title="Looking for a dependable partner on site?"
    body="Request a quote for your next restoration, commercial cleaning, remediation, or staffing requirement—or apply to join our crew."
    primaryHref={ctas.quote.href}
    primaryLabel={ctas.quote.label}
    secondaryHref={ctas.apply.href}
    secondaryLabel={ctas.apply.label}
  />
</BaseLayout>
